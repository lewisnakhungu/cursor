{
  "name": "afyasmart-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:push:local": "tsx prisma/push-local.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-stock": "tsx prisma/seed-stock.ts",
    "db:seed-tenants": "tsx prisma/seed-tenants.ts",
    "db:seed-auth": "tsx prisma/seed-auth.ts",
    "db:migrate-multitenant": "tsx prisma/migrate-to-multitenant.ts",
    "db:neon:multitenant": "tsx prisma/neon-multitenant-setup.ts",
    "db:seed-aliases": "tsx prisma/seed-aliases.ts",
    "db:seed-hybrid-catalog": "tsx prisma/seed-hybrid-catalog.ts",
    "db:seed-kemsa": "tsx prisma/seed-kemsa.ts",
    "db:cleanup-catalog-aliases": "tsx prisma/cleanup-catalog-aliases.ts",
    "audit:catalog:export": "PYTHONPATH=scripts python3 -m catalog_audit.export_db",
    "audit:catalog": "PYTHONPATH=scripts python3 -m catalog_audit.run_audit",
    "audit:kemsa": "PYTHONPATH=scripts python3 -m catalog_audit.reconcile_kemsa",
    "audit:kemsa:apply": "PYTHONPATH=scripts python3 -m catalog_audit.reconcile_kemsa --apply-hybrid",
    "scrape:kemsa": "tsx prisma/scrape-kemsa-catalog.ts",
    "db:seed-catalog": "tsx prisma/seed-catalog-all.ts",
    "db:neon:catalog": "tsx prisma/neon-catalog-refresh.ts",
    "db:neon:setup": "tsx prisma/neon-setup.ts",
    "db:fix-warfarin": "tsx prisma/fix-warfarin.ts",
    "db:backfill-sale-line-item-type": "tsx prisma/backfill-sale-line-item-type.ts",
    "db:add-constraints": "tsx prisma/add-constraints.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/nextjs": "^10.53.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^17.4.2",
    "idb": "^8.0.3",
    "jose": "^6.2.3",
    "lucide-react": "^1.16.0",
    "next": "14.2.35",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "pg": "^8.21.0",
    "react": "^18",
    "react-dom": "^18",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
