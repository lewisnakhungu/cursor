# Copy to .env and .env.local:
#   cp .env.example .env
#   cp .env.example .env.local
#
# Only ONE variable is used at runtime: DATABASE_URL
# Prisma/Next load .env.local first, then .env (.env does NOT override .env.local).

# -----------------------------------------------------------------------------
# .env.local  (gitignored — your machine, local Postgres)
# Put this file beside .env; use for normal development on localhost.
# -----------------------------------------------------------------------------

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/afyasmart_stock?schema=public

# -----------------------------------------------------------------------------
# .env  (Neon / Vercel / shared secrets — or comment DATABASE_URL when using .env.local)
# On Vercel, set DATABASE_URL in the project dashboard (do not commit real secrets).
# -----------------------------------------------------------------------------

# Neon pooled (runtime + dev against cloud DB)
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Neon direct (optional — migrations/seeds only; not used by app unless you swap)
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# Auth (required) — min 16 characters; use openssl rand -base64 32
# -----------------------------------------------------------------------------

AUTH_SECRET=replace-with-long-random-secret

# After db:seed-auth (same on Neon if you run it against DATABASE_URL in .env):
#   Super user: admin@afyasmart.local / ChangeMeAdmin1!
#   Demo owner: owner@default.local / ChangeMeOwner1!
# Override at seed time: SUPER_EMAIL=... SUPER_PASSWORD=...

# -----------------------------------------------------------------------------
# Optional dev seeds: npm run db:seed-tenants && npm run db:seed-auth
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Sentry (optional)
# SENTRY_ORG + SENTRY_PROJECT are needed at BUILD time (Vercel env vars) for
# source map uploads — without them, stack traces in Sentry stay minified.
# -----------------------------------------------------------------------------

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# -----------------------------------------------------------------------------
# App display (optional)
# -----------------------------------------------------------------------------

NEXT_PUBLIC_FACILITY_NAME=AfyaSmart Facility

# Landing page demo / contact CTA (mailto) — set a REAL inbox in Vercel,
# the .local fallback is a placeholder visitors cannot reach.
NEXT_PUBLIC_CONTACT_EMAIL=hello@afyasmart.local

# -----------------------------------------------------------------------------
# Quick reference — which file wins?
# -----------------------------------------------------------------------------
# | You want…              | Active DATABASE_URL in…      |
# |------------------------|------------------------------|
# | Local Postgres         | .env.local only              |
# | Neon while coding      | .env only (empty .env.local) |
# | Vercel production      | Vercel env vars (DATABASE_URL)|
