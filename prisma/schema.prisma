// AfyaSmart-Stock — see ARCHITECTURE.md at repo root

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SaleLineStatus {
  ACTIVE
  VOIDED
}

model Medicine {
  id          String   @id @default(cuid())
  genericName String
  dosageForm  String   @default("")
  strength    String   @default("")
  searchKey   String   @unique
  kemlCode    String?
  levelOfUse  String?
  chapter     String?
  section     String?
  kemlPage    Int?
  isStub      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stockBatches StockBatch[]
  saleLines    SaleLine[]
  aliases      MedicineAlias[]

  @@index([genericName])
  @@index([isStub])
  @@map("medicines")
}

model MedicineAlias {
  id         String   @id @default(cuid())
  name       String
  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([medicineId, name])
  @@index([name])
  @@map("medicine_aliases")
}

model StockBatch {
  id              String   @id @default(cuid())
  medicineId      String
  batchNumber     String?
  supplierName    String?
  quantityOnHand  Int
  expiryDate      DateTime @db.Date
  supplierCost    Decimal? @db.Decimal(12, 2)
  retailSalePrice Decimal? @db.Decimal(12, 2)
  receivedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  medicine  Medicine   @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  saleLines SaleLine[]

  @@index([medicineId, expiryDate])
  @@index([expiryDate])
  @@map("stock_batches")
}

model Sale {
  id          String     @id @default(cuid())
  createdAt   DateTime   @default(now())
  totalAmount Decimal    @default(0) @db.Decimal(14, 2)
  lines       SaleLine[]

  @@index([createdAt])
  @@map("sales")
}

model SaleLine {
  id             String         @id @default(cuid())
  saleId         String
  medicineId     String
  stockBatchId   String
  quantity       Int
  unitPrice      Decimal        @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal        @default(0) @db.Decimal(12, 2)
  status         SaleLineStatus @default(ACTIVE)
  correctionNote String?
  genericName    String
  dosageForm     String
  strength       String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt

  sale       Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicine   Medicine   @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  stockBatch StockBatch @relation(fields: [stockBatchId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([medicineId])
  @@index([status])
  @@map("sale_lines")
}
