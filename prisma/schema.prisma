// AfyaSmart-Stock — see ARCHITECTURE.md at repo root

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SaleLineStatus {
  ACTIVE
  VOIDED
}

enum TenantRole {
  OWNER
  DEPUTY
  DISPENSER
}

/// Health facility / pharmacy — operational data is scoped by tenantId.
model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  batches     StockBatch[]
  sales       Sale[]
  saleLines   SaleLine[]
  memberships Membership[]

  @@map("tenants")
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  passwordHash    String?
  name            String?
  isPlatformAdmin Boolean      @default(false)
  /** Bumped on password change/reset and membership removal to invalidate old JWTs */
  sessionVersion  Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  memberships     Membership[]

  @@map("users")
}

model Membership {
  id        String     @id @default(cuid())
  tenantId  String
  userId    String
  role      TenantRole @default(DISPENSER)
  createdAt DateTime   @default(now())
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

/// How staff count stock for a batch (qty 5 + BOX = five boxes, not five tablets).
enum StockUnit {
  TABLET
  CAPSULE
  STRIP
  BOX
  BOTTLE
  VIAL
  TUBE
  SACHET
  UNIT
}

model Medicine {
  id          String   @id @default(cuid())
  genericName String
  dosageForm  String   @default("")
  strength    String   @default("")
  searchKey   String   @unique
  kemlCode    String?
  levelOfUse  String?
  chapter     String?
  section     String?
  kemlPage    Int?
  isStub      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stockBatches StockBatch[]
  saleLines    SaleLine[]
  aliases      MedicineAlias[]

  @@index([genericName])
  @@index([isStub])
  @@map("medicines")
}

model MedicineAlias {
  id         String   @id @default(cuid())
  name       String
  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([medicineId, name])
  @@index([name])
  @@map("medicine_aliases")
}

model StockBatch {
  id               String    @id @default(cuid())
  tenantId         String    @default("default")
  medicineId       String
  batchNumber      String?
  supplierName     String?
  quantityOnHand   Int
  quantityReceived Int       @default(0)
  expiryDate       DateTime  @db.Date
  supplierCost     Decimal?  @db.Decimal(12, 2)
  retailSalePrice  Decimal?  @db.Decimal(12, 2)
  stockUnit        StockUnit @default(UNIT)
  unitsPerPack     Int?
  receivedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  medicine  Medicine   @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  saleLines SaleLine[]

  @@index([tenantId, medicineId, expiryDate])
  @@index([medicineId, expiryDate])
  @@index([expiryDate])
  @@index([receivedAt])
  @@map("stock_batches")
}

model Sale {
  id          String     @id @default(cuid())
  tenantId    String     @default("default")
  createdAt   DateTime   @default(now())
  totalAmount Decimal    @default(0) @db.Decimal(14, 2)
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lines       SaleLine[]

  @@index([tenantId, createdAt])
  @@index([createdAt])
  @@map("sales")
}

model SaleLine {
  id             String         @id @default(cuid())
  tenantId       String         @default("default")
  saleId         String
  medicineId     String
  stockBatchId   String
  quantity       Int
  unitPrice      Decimal        @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal        @default(0) @db.Decimal(12, 2)
  status         SaleLineStatus @default(ACTIVE)
  correctionNote String?
  genericName    String
  dosageForm     String
  strength       String
  stockUnit      StockUnit      @default(UNIT)
  unitsPerPack   Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sale       Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicine   Medicine   @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  stockBatch StockBatch @relation(fields: [stockBatchId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([saleId])
  @@index([medicineId])
  @@index([status])
  @@map("sale_lines")
}
