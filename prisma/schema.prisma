// AfyaSmart-Stock — see docs/ARCHITECTURE.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SaleLineStatus {
  ACTIVE
  VOIDED
}

enum ProcurementOrderStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_RECEIVED
  CLOSED
}

enum ProcurementLineReason {
  LOW_STOCK
  MANUAL
  NEW_ITEM
}

enum TenantRole {
  OWNER
  DEPUTY
  DISPENSER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

/// Health facility / pharmacy — operational data is scoped by tenantId.
model Tenant {
  id                  String       @id @default(cuid())
  name                String
  slug                String       @unique
  status              TenantStatus @default(ACTIVE)
  suspendedReason     String?
  suspendedAt         DateTime?
  /// SaaS provider feature switches & tier limits
  offlineModeAllowed  Boolean      @default(true)
  reportsEnabled      Boolean      @default(true)
  procurementEnabled  Boolean      @default(true)
  maxStaffAccounts    Int          @default(3)
  /// Owner opt-in: preload catalog/stock and allow offline dispense (see /settings/facility).
  offlineModeEnabled  Boolean      @default(false)
  createdAt           DateTime     @default(now())
  batches             StockBatch[]
  sales               Sale[]
  saleLines           SaleLine[]
  memberships         Membership[]
  procurementOrders   ProcurementOrder[]
  reorderPolicies     MedicineReorderPolicy[]
  suppliers           Supplier[]
  stockMovements      StockMovement[]

  @@map("tenants")
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  passwordHash    String?
  name            String?
  isPlatformAdmin Boolean      @default(false)
  /** Bumped on password change/reset and membership removal to invalidate old JWTs */
  sessionVersion  Int          @default(0)
  /** Set when an admin/owner assigns the password; forces self-service change at next sign-in */
  mustChangePassword Boolean   @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  memberships     Membership[]
  salesDispensed  Sale[]           @relation("SalesDispensed")
  stockMovements  StockMovement[]  @relation("StockMovements")

  @@map("users")
}

model Membership {
  id        String     @id @default(cuid())
  tenantId  String
  userId    String
  role      TenantRole @default(DISPENSER)
  createdAt DateTime   @default(now())
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

/// How staff count stock for a batch (qty 5 + BOX = five boxes, not five tablets).
enum StockUnit {
  TABLET
  CAPSULE
  STRIP
  BOX
  BOTTLE
  VIAL
  TUBE
  SACHET
  UNIT
}

/// Pharmaceutical vs medical consumables/diagnostics (hybrid catalog extension).
enum CatalogItemType {
  MEDICINE
  NON_PHARM
}

/// Where a catalog alias originated (ingestion pipeline or user learning).
enum AliasSource {
  KEML
  BRAND_SEED
  HYBRID
  KEMSA
  USER_CONFIRMED
  IMPORT_LEARNED
}

enum AliasStatus {
  ACTIVE
  PENDING
  REVOKED
}

enum AliasProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Medicine {
  id          String           @id @default(cuid())
  genericName String
  dosageForm  String           @default("")
  strength    String           @default("")
  searchKey   String           @unique
  itemType    CatalogItemType  @default(MEDICINE)
  category    String?
  kemlCode    String?
  levelOfUse  String?
  chapter     String?
  section     String?
  kemlPage    Int?
  isStub      Boolean          @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stockBatches         StockBatch[]
  saleLines            SaleLine[]
  aliases              MedicineAlias[]
  aliasProposals       CatalogAliasProposal[]
  procurementLines     ProcurementOrderLine[]
  reorderPolicies      MedicineReorderPolicy[]

  @@index([genericName])
  @@index([isStub])
  @@index([itemType])
  @@map("medicines")
}

model MedicineAlias {
  id         String      @id @default(cuid())
  name       String
  medicineId String
  source     AliasSource @default(BRAND_SEED)
  status     AliasStatus @default(ACTIVE)
  /** Facility that taught this alias; null = global seed data */
  tenantId   String?
  learnedAt  DateTime?
  medicine   Medicine    @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())

  @@unique([medicineId, name])
  @@index([name])
  @@index([status])
  @@index([source])
  @@map("medicine_aliases")
}

/// Supplier name → catalog mapping awaiting platform review (conflicts or low confidence).
model CatalogAliasProposal {
  id           String              @id @default(cuid())
  rawName      String
  medicineId   String
  tenantId     String
  proposedById String?
  status       AliasProposalStatus @default(PENDING)
  note         String?
  createdAt    DateTime            @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  medicine     Medicine            @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([rawName])
  @@map("catalog_alias_proposals")
}

model StockBatch {
  id               String    @id @default(cuid())
  tenantId         String
  medicineId       String
  batchNumber      String?
  supplierName     String?
  quantityOnHand   Int
  quantityReceived Int       @default(0)
  expiryDate       DateTime  @db.Date
  supplierCost     Decimal?  @db.Decimal(12, 2)
  retailSalePrice  Decimal?  @db.Decimal(12, 2)
  stockUnit        StockUnit @default(UNIT)
  unitsPerPack     Int?
  receivedAt           DateTime  @default(now())
  procurementOrderId   String?
  procurementLineId    String?
  /** User who received this batch into inventory (audit trail). */
  receivedById         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  medicine          Medicine              @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  saleLines         SaleLine[]
  procurementOrder  ProcurementOrder?     @relation(fields: [procurementOrderId], references: [id], onDelete: SetNull)
  procurementLine   ProcurementOrderLine? @relation(fields: [procurementLineId], references: [id], onDelete: SetNull)
  stockMovements    StockMovement[]

  @@index([tenantId, medicineId, expiryDate])
  @@index([procurementOrderId])
  @@index([medicineId, expiryDate])
  @@index([expiryDate])
  @@index([receivedAt])
  @@map("stock_batches")
}

model Sale {
  id             String     @id @default(cuid())
  tenantId       String
  createdAt      DateTime   @default(now())
  totalAmount    Decimal    @default(0) @db.Decimal(14, 2)
  /** Staff member who performed this dispense (audit trail). */
  dispensedById  String?
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  dispensedBy    User?      @relation("SalesDispensed", fields: [dispensedById], references: [id])
  lines          SaleLine[]

  @@index([tenantId, createdAt])
  @@index([createdAt])
  @@map("sales")
}

model SaleLine {
  id             String         @id @default(cuid())
  tenantId       String
  saleId         String
  medicineId     String
  stockBatchId   String
  quantity       Int
  unitPrice      Decimal        @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal        @default(0) @db.Decimal(12, 2)
  status         SaleLineStatus @default(ACTIVE)
  correctionNote String?
  /** User who corrected/voided this line (null if never corrected). */
  correctedById  String?
  genericName    String
  dosageForm     String
  strength       String
  itemType       CatalogItemType  @default(MEDICINE)
  stockUnit      StockUnit      @default(UNIT)
  unitsPerPack   Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sale       Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicine   Medicine   @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  stockBatch StockBatch @relation(fields: [stockBatchId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([saleId])
  @@index([medicineId])
  @@index([status])
  @@index([itemType])
  @@map("sale_lines")
}

model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  contact   String?
  notes     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders ProcurementOrder[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("suppliers")
}

model MedicineReorderPolicy {
  id              String @id @default(cuid())
  tenantId        String
  medicineId      String
  reorderPoint    Int?
  targetLevel     Int?
  leadTimeDays    Int    @default(14)
  safetyStockDays Int    @default(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@unique([tenantId, medicineId])
  @@index([tenantId])
  @@map("medicine_reorder_policies")
}

model ProcurementOrder {
  id           String                   @id @default(cuid())
  tenantId     String
  reference    String
  status       ProcurementOrderStatus   @default(DRAFT)
  notes        String?
  supplierName String?
  supplierId   String?
  createdById  String
  approvedById String?
  expiryWatch  Json?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  submittedAt  DateTime?

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier   Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  lines      ProcurementOrderLine[]
  stockBatches StockBatch[]

  @@unique([tenantId, reference])
  @@index([tenantId, status, createdAt])
  @@map("procurement_orders")
}

model ProcurementOrderLine {
  id           String                @id @default(cuid())
  tenantId     String
  orderId      String
  medicineId   String
  suggestedQty Int
  orderedQty   Int
  receivedQty  Int                   @default(0)
  stockUnit    StockUnit
  unitsPerPack Int?
  reason       ProcurementLineReason
  priority     String                @default("NORMAL")
  notes        String?
  sourceMeta   Json?
  sortOrder    Int                   @default(0)

  order        ProcurementOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicine     Medicine         @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  stockBatches StockBatch[]

  @@index([orderId])
  @@index([tenantId, medicineId])
  @@map("procurement_order_lines")
}

/// Append-only event types for the inventory audit ledger.
enum StockMovementType {
  RECEIVE
  DISPENSE
  CORRECTION_INCREASE
  CORRECTION_DECREASE
  VOIDED_RETURN
}

/// Immutable audit ledger — every inventory change is an append-only event.
/// Protected by a database trigger that blocks UPDATE and DELETE.
model StockMovement {
  id             String            @id @default(cuid())
  tenantId       String
  stockBatchId   String
  type           StockMovementType
  quantityDelta  Int               /// Signed (+receive, -dispense)
  balanceAfter   Int               /// Reconciled balance at point of entry
  referenceType  String            /// e.g. "SALE", "PROCUREMENT", "CORRECTION"
  referenceId    String?           /// saleLineId, procurementLineId, etc.
  reason         String?
  performedById  String            /// Strict authenticated User ID
  createdAt      DateTime          @default(now())

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  stockBatch     StockBatch        @relation(fields: [stockBatchId], references: [id], onDelete: Restrict)
  performedBy    User              @relation("StockMovements", fields: [performedById], references: [id])

  @@index([tenantId, stockBatchId, createdAt])
  @@index([performedById, createdAt])
  @@map("stock_movements")
}
